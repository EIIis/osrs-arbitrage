# Discord Developer Portal -> your application -> Bot -> token
DISCORD_TOKEN=
# Enable Developer Mode in Discord, then right-click -> Copy ID
DISCORD_OWNER_ID=0
DISCORD_GUILD_ID=0
DISCORD_CHANNEL_ID=0

# A NEW SQLite database. Old DATABASE_URL/PostgreSQL settings are ignored.
DB_PATH=data/osrs.sqlite3
BACKUP_DIR=data/backups
TIMEZONE=America/Chicago
LOG_LEVEL=INFO
DEFAULT_BUDGET=0

WIKI_API_URL=https://prices.runescape.wiki/api/v2/osrs
# Add your Discord username or repository contact before running.
WIKI_USER_AGENT="osrs-arbitrage/0.2 - @your-discord-username"
HISTORY_REQUEST_INTERVAL=1.0
HISTORY_SHORTLIST_SIZE=20
# Optional rule tuning; values are percentages, not fractions.
# ANALYSIS_OVERRIDES='{"quick":{"min_roi":"0.5","decline_warning":"2"}}'
