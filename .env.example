# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/osrs_arbitrage

# Admin API Key (change this to a secure random string)
ADMIN_API_KEY=your-secure-admin-key-here

# RuneLite API Base URL (usually no need to change)
RUNELITE_API_BASE_URL=https://prices.runescape.wiki/api/v1/osrs

# Polling Configuration
POLL_INTERVAL_MINUTES=5

# API Configuration
API_V1_PREFIX=/api/v1
LOG_LEVEL=DEBUG

# CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=*
